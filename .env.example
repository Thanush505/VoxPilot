# ==============================================================================
# VoxPilot Environment Configuration
# Copy this file to .env and adjust values as needed
# ==============================================================================

# Core API & Server Configuration
APP_NAME=VoxPilot
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-secret-key

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./voxpilot.db

# AI & LLM (Ollama / Local models)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2

# Voice & Speech Configuration
# Microphone Selection: Leave blank for system default, or set device index (e.g., 1) or name substring (e.g., WF-1000XM5, Realtek)
VOXPILOT_MICROPHONE_DEVICE=

# Audio Preprocessing & Gain Normalization
VOXPILOT_AUDIO_NORMALIZATION_ENABLED=true
VOXPILOT_AUDIO_TARGET_PEAK_DBFS=-3.0
VOXPILOT_AUDIO_MAX_GAIN_DB=20.0
VOXPILOT_AUDIO_MIN_PEAK_DBFS=-45.0

# Voice Activity Detection (Faster-Whisper Batch Silero VAD)
VOXPILOT_VAD_ENABLED=true
VOXPILOT_VAD_THRESHOLD=0.5
VOXPILOT_VAD_MIN_SPEECH_DURATION_MS=250
VOXPILOT_VAD_MIN_SILENCE_DURATION_MS=500
VOXPILOT_VAD_SPEECH_PAD_MS=200

# Streaming Recording VAD (WebRTC Real-Time End-of-Speech Detection)
VOXPILOT_STREAMING_VAD_ENABLED=true
VOXPILOT_STREAMING_VAD_FRAME_DURATION_MS=30
VOXPILOT_STREAMING_VAD_AGGRESSIVENESS=2
VOXPILOT_STREAMING_VAD_END_SILENCE_MS=800
VOXPILOT_STREAMING_VAD_PRE_ROLL_MS=300
VOXPILOT_STREAMING_VAD_MIN_SPEECH_MS=300
VOXPILOT_STREAMING_VAD_MAX_RECORDING_SECONDS=30.0
VOXPILOT_STREAMING_VAD_START_TIMEOUT_SECONDS=10.0

# Wake Word Detection (openWakeWord Offline Engine)
# Set to true to enable wake word activation. Default model uses 'hey_jarvis_v0.1' until 'models/wake_word/hey_voxpilot.onnx' is trained.
VOXPILOT_WAKE_WORD_ENABLED=false
VOXPILOT_WAKE_WORD_MODEL=hey_jarvis_v0.1
VOXPILOT_WAKE_WORD_THRESHOLD=0.5
VOXPILOT_WAKE_WORD_COOLDOWN_SECONDS=2.0

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
WAKE_WORD=hey_voxpilot
AUDIO_SAMPLE_RATE=16000

# Automation & Safety
AUTOMATION_SAFETY_FAILSAFE=True
AUTOMATION_PAUSE_SECONDS=0.5

# Frontend Configuration (React + Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000


