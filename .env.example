# ==============================================================================
# VoxPilot Environment Configuration
# Copy this file to .env and adjust values as needed
# ==============================================================================

# Core API & Server Configuration
APP_NAME=VoxPilot
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-secret-key

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./voxpilot.db

# AI & LLM (Ollama / Local models)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2

# Voice & Speech Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
WAKE_WORD=hey_voxpilot
AUDIO_SAMPLE_RATE=16000

# Automation & Safety
AUTOMATION_SAFETY_FAILSAFE=True
AUTOMATION_PAUSE_SECONDS=0.5

